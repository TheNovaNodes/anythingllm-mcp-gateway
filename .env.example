# AnythingLLM MCP Gateway Configuration (Go 1.25+)
# Copy this file to .env and configure your environment

# --- Core AnythingLLM Connection ---
# AnythingLLM REST API endpoint (no trailing slash)
# Default local instance: http://127.0.0.1:3002/api/v1
MG_ALM_BASE=http://127.0.0.1:3002/api/v1

# Bearer API Key: set directly or via token file
MG_API_KEY=
# ANYTHINGLLM_API_KEY=

# Optional: Path to file containing bearer token (reloaded dynamically on change)
# MG_TOKEN_FILE=/path/to/anythingllm_token.txt

# --- Multi-Tenant Organization Isolation (CRITICAL SECURITY) ---
# Comma-separated list of allowed organization slugs for multi-tenant isolation.
# Prevents cross-organization data leakage in multi-repository agent environments.
# Example: thenovanodes,thedoctormes-hue
MG_ALLOWED_ORGS=thenovanodes

# --- Workspace & Lexical DB Configuration ---
# Default AnythingLLM workspace slug
MG_WORKSPACE=default

# Path to SQLite FTS5 lexical search database (generated by anythingllm-sync)
# Default: ./lexical.db (or auto-detected shared ledger if present)
MG_LEXICAL_DB=/path/to/anythingllm-sync/lexical.db

# Optional workspace slug mapping file
# MG_MAP_FILE=/path/to/anythingllm_workspaces.map

# --- Search & Retrieval Tuning ---
# Default and maximum number of search results
MG_DEFAULT_TOP_K=5
MG_MAX_TOP_K=25

# Minimum AnythingLLM vector similarity score threshold (raw cosine score from ALM)
MG_VECTOR_SCORE_THRESHOLD=0.13

# Minimum cosine similarity cutoff for pure-vector hits without lexical corroboration
# Discards out-of-domain embedding drift and false positives
MG_MIN_VECTOR_SIMILARITY=0.55

# Minimum lexical BM25 score threshold
MG_LEXICAL_MIN_SCORE=0.0

# --- Hybrid Fusion (RRF) & Synergy ---
# Reciprocal Rank Fusion smoothing constant (default: 60)
MG_RRF_K=60

# Weight multiplier for vector retrieval layer in RRF (default: 1.0)
MG_VECTOR_WEIGHT=1.0

# Weight multiplier for lexical FTS5 layer in RRF (default: 1.0)
MG_LEXICAL_WEIGHT=1.0

# Hybrid synergy multiplier: bonus applied when hit is corroborated by both vector and lexical layers (default: 0.25)
MG_HYBRID_SYNERGY=0.25

# --- Concurrency & Timeouts ---
# Maximum concurrent inflight vector search requests to protect AnythingLLM from swarms
MG_VECTOR_MAX_INFLIGHT=4

# Search request timeout in seconds (default: 10)
MG_SEARCH_TIMEOUT=10
