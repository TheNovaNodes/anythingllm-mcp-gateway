# Nova-AnythingLLM-MCP Configuration
# Copy this file to .env and fill in your values

# AnythingLLM REST API endpoint (no trailing slash)
MG_ALM_BASE=http://127.0.0.1:3002/api/v1

# Bearer token for AnythingLLM vector search (read from file)
MG_TOKEN_FILE=/path/to/anythingllm_token.txt

# Operational directory for lexical index
MG_OPS_DIR=/path/to/anythingllm-sync

# FTS5/BM25 lexical database path
MG_LEXICAL_DB=/path/to/anythingllm-sync/lexical.db

# Workspace map file (slug mappings)
MG_MAP_FILE=/path/to/anythingllm_workspaces.map

# --- Timeouts (seconds) ---
MG_LIST_TIMEOUT=15
MG_SEARCH_TIMEOUT=30

# --- Search Parameters ---
MG_DEFAULT_TOP_K=5
MG_MAX_TOP_K=25
MG_VECTOR_SCORE_THRESHOLD=0.13
MG_LEXICAL_MIN_SCORE=1.0
MG_RRF_K=60
MG_QUERY_MAX_LEN=1000
MG_CANDIDATE_MULT=3
MG_VECTOR_MAX_WORKERS=6
MG_VECTOR_MAX_INFLIGHT=4

# --- Fusion Strategy ---
MG_FUSION_MODE=weighted
MG_FUSION_VECTOR_WEIGHT=0.6
MG_FUSION_MIN_COMBINED=0.05

# --- Context Assembly ---
MG_EXPAND_CONTEXT_DEFAULT=1
MG_EXPAND_PARAGRAPHS=1
MG_EXPAND_MAX_CHARS=4000
MG_CONTEXT_ANCHOR_MIN=30

# --- Logging ---
MG_LOG_DIR=/path/to/logs
MG_LOG_LEVEL=INFO

# --- MCP Transport ---
MG_TRANSPORT=stdio
MG_HOST=127.0.0.1
MG_PORT=8091

# --- Deep Research Orchestrator ---
DEEP_RESEARCH_ORCHESTRATOR=/path/to/research-orchestrator.py
DEEP_RESEARCH_TIMEOUT=60